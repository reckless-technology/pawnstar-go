# The shell scripts, the hooks and the Makefile are read by bash and make on every platform - on Windows by Git's bash
# and by MSYS2's, whose bash refuses a carriage return at the end of `set -o pipefail`. A clone with core.autocrlf=true,
# every Windows clone here, would otherwise write them CRLF, and `make` would link the version as an empty string. So
# they stay LF in the working copy whatever the clone's setting; everything else follows the clone's own choice.
*.sh text eol=lf
.githooks/* text eol=lf
Makefile text eol=lf

# Data the engine embeds (go:embed) or a test reads byte for byte is checked out exactly as committed, with no
# line-ending conversion: under autocrlf=true a Windows build would embed a CRLF book where Linux and macOS embed LF -
# a byte-different binary for the same commit.
engine/book.txt                     -text
engine/testdata/nnue_reference.txt  -text
engine/nnue/*.bin                   -text

# The net is binary, so git's own content detection would leave it alone anyway; declaring it says so, and the
# RNNUE1 container's payload CRC now makes a mangled checkout a loud refusal rather than a wrong evaluation.
