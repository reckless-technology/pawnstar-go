{
  // The NNUE kernels build only with GOEXPERIMENT=simd (the Makefile exports it, with GOAMD64=v3, for every build and
  // test). The Go extension's tools and gopls must see the same environment, or gopls drops the simd-tagged files
  // and the editor's test runs build the scalar fallback. Both variables are harmless on arm64.
  "go.toolsEnvVars": { "GOEXPERIMENT": "simd", "GOAMD64": "v3" },
  "go.testEnvVars": { "GOEXPERIMENT": "simd", "GOAMD64": "v3" },
  "gopls": { "build.env": { "GOEXPERIMENT": "simd", "GOAMD64": "v3" } },
  // The engine package's suite runs for about a minute (perft, search, Bratko-Kopec), far past the extension's 30 s.
  "go.testTimeout": "15m",
  // CI's linter, with the repo's .golangci.yml (version 2).
  "go.lintTool": "golangci-lint-v2"
}
