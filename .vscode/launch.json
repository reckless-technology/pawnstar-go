{
    // Delve through the Go extension, the same on Linux, macOS and Windows. The launch builds with the Makefile's
    // GOEXPERIMENT=simd and GOAMD64=v3, so the debugged engine runs the SIMD kernels the release does. It runs in the
    // integrated terminal: type UCI commands there (uci, position ..., go ..., bench).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pawnstar-go",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}",
            "env": { "GOEXPERIMENT": "simd", "GOAMD64": "v3" },
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to running pawnstar-go",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "cwd": "${workspaceFolder}",
            "processId": "${command:pickGoProcess}"
        }
    ]
}
